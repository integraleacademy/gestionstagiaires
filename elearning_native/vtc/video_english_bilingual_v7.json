        "lang": "en",
        "text": "at"
      },
      {
        "lang": "fr",
        "text": " = à un point, "
      },
      {
        "lang": "en",
        "text": "next to"
      },
      {
        "lang": "fr",
        "text": " = à côté de, "
      },
      {
        "lang": "en",
        "text": "opposite"
      },
      {
        "lang": "fr",
        "text": " = en face de, "
