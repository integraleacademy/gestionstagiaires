{
	admin off
	auto_https off
}

(browser_page) {
	method GET
	header Accept *text/html*
	not path /healthz /api /api/* /internal /internal/* /webhooks /webhooks/* /.well-known/*
	not header Upgrade *
	not header Range *
	header_regexp dest Sec-Fetch-Dest ^(document|iframe)$
}

(waiting) {
	route {
		header {
			Cache-Control "no-store, max-age=0"
			Retry-After 12
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
		}
		request_header -Range
		request_header -If-Modified-Since
		request_header -If-None-Match
		rewrite * /index.html
		file_server {
			root /srv/waiting
			status 503
			disable_canonical_uris
		}
	}
}

(origin) {
	header_up Host {$ORIGIN_HOST:gestionstagiaires-r5no.onrender.com}
	header_up X-Forwarded-Host {$PUBLIC_HOST:www.integraleconnect.com}
	header_up X-Forwarded-Proto https
	header_down Location "^https?://gestionstagiaires-r5no[.]onrender[.]com(/.*|$)" "https://{$PUBLIC_HOST:www.integraleconnect.com}$1"
}

(page_proxy) {
	vars waiting_page yes
	reverse_proxy {args[0]} {
		import origin
		@gateway_error status 502 503 504
		handle_response @gateway_error {
			import waiting
		}
	}
}

:{$PORT:8080} {
	@gateway_health {
		method GET HEAD
		path /__connect_gateway_health
	}
	handle @gateway_health {
		respond 204
	}
	# This loopback response lets a visitor reproduce a 502 without touching the app.
	@fixture {
		remote_ip 127.0.0.1 ::1
		path /__connect_fixture_502
	}
	handle @fixture {
		respond 502
	}
	@demo {
		host gestionstagiaires-docker-test.onrender.com
		method GET
		path /test-502
	}
	handle @demo {
		route {
			rewrite * /__connect_fixture_502
			import page_proxy http://127.0.0.1:{$PORT:8080}
		}
	}
	@origin_probe {
		host gestionstagiaires-docker-test.onrender.com
		method GET
		path /__connect_origin_health
	}
	handle @origin_probe {
		route {
			request_header -Cookie
			request_header -Authorization
			rewrite * /healthz
			reverse_proxy {$UPSTREAM:https://gestionstagiaires-r5no.onrender.com} {
				import origin
			}
		}
	}
	@public host {$PUBLIC_HOST:www.integraleconnect.com}
	handle @public {
		@navigation {
			import browser_page
		}
		@legacy_navigation {
			method GET
			header Accept *text/html*
			not header Sec-Fetch-Dest *
			not header X-Requested-With *
			not header Range *
			not header Upgrade *
			not path /healthz /api /api/* /internal /internal/* /webhooks /webhooks/* /.well-known/*
		}
		handle @navigation {
			import page_proxy {$UPSTREAM:https://gestionstagiaires-r5no.onrender.com}
		}
		handle @legacy_navigation {
			import page_proxy {$UPSTREAM:https://gestionstagiaires-r5no.onrender.com}
		}
		handle {
			reverse_proxy {$UPSTREAM:https://gestionstagiaires-r5no.onrender.com} {
				import origin
			}
		}
	}
	handle {
		respond 404
	}
	handle_errors {
		@pageFailure expression `{http.vars.waiting_page} == "yes" && {err.status_code} in [502, 503, 504]`
		handle @pageFailure {
			import waiting
		}
		handle {
			respond "{err.status_code}" {err.status_code}
		}
	}
}
